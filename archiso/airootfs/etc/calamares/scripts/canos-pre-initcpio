#!/bin/bash
# Runs inside the freshly unpacked system, before the initramfs is built:
# drops live-only mkinitcpio settings and installs every kernel to /boot.
rm -f /etc/mkinitcpio.conf.d/archiso.conf
rm -f /etc/mkinitcpio.d/linux.preset
for dir in /usr/lib/modules/*/; do
    [ -f "$dir/pkgbase" ] && [ -f "$dir/vmlinuz" ] || continue
    pkgbase=$(cat "$dir/pkgbase")
    # dense copy: the unpacked kernel is sparse, GRUB cannot read files with holes on btrfs ("premature end of file")
    cp --reflink=never --sparse=never "$dir/vmlinuz" "/boot/vmlinuz-$pkgbase"
    chmod 644 "/boot/vmlinuz-$pkgbase"
    sed "s|%PKGBASE%|$pkgbase|g" /usr/share/mkinitcpio/hook.preset > "/etc/mkinitcpio.d/$pkgbase.preset"
done

# NVIDIA: load the driver early (Plymouth + no flicker), only if it is installed
if lspci 2>/dev/null | grep -qi 'vga.*nvidia\|3d.*nvidia' && find /usr/lib/modules -name 'nvidia[-_]drm.ko*' 2>/dev/null | grep -q .; then
    echo 'MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)' > /etc/mkinitcpio.conf.d/canos-nvidia.conf
fi

# Plymouth boot / shutdown animation
if [ -d /usr/share/plymouth/themes/canos ]; then
    mkdir -p /etc/plymouth
    printf '[Daemon]\nTheme=canos\nShowDelay=0\nDeviceTimeout=8\n' > /etc/plymouth/plymouthd.conf
fi

# GRUB (grubcfg from CachyOS only runs with its bootloader chooser)
g=/etc/default/grub
set_grub() {
    sed -i -e "/^#\?$1=/d" "$g"
    echo "$1=\"$2\"" >> "$g"
}
set_grub GRUB_DISTRIBUTOR "CanOS"
set_grub GRUB_TIMEOUT 5
set_grub GRUB_TIMEOUT_STYLE menu
set_grub GRUB_CMDLINE_LINUX_DEFAULT "nowatchdog nvme_load=YES quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=auto vt.global_cursor_default=0 nvidia_drm.modeset=1 nvidia_drm.fbdev=1"
set_grub GRUB_GFXMODE auto
set_grub GRUB_GFXPAYLOAD_LINUX keep
set_grub GRUB_DISABLE_OS_PROBER false
set_grub GRUB_THEME "/usr/share/grub/themes/canos/theme.txt"
# main entry boots the normal kernel, LTS is under "Advanced options"
[ -f /boot/vmlinuz-linux-cachyos ] && set_grub GRUB_TOP_LEVEL "/boot/vmlinuz-linux-cachyos"
sed -i -e "/^#\?GRUB_DISABLE_SUBMENU=/d" "$g"
# CanOS menu order: CanOS, other systems, firmware settings, advanced options (canos-tools: /etc/grub.d/*canos*)
if [ -f /etc/grub.d/10_canos ]; then
    chmod -x /etc/grub.d/10_linux /etc/grub.d/30_os-prober /etc/grub.d/30_uefi-firmware /etc/grub.d/31_efi_bootnext 2>/dev/null
fi
exit 0
