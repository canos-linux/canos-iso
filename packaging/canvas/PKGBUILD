# Built by ../build-repo.sh (pkgver comes from VERSION in the Canvas repo)
pkgname=canvas
pkgver=1.0
pkgrel=1
pkgdesc="Canvas – the desktop of CanOS (Quickshell shell for Hyprland)"
arch=(any)
url="https://github.com/canos-linux/canvas"
license=(GPL-3.0-only)
depends=(quickshell hyprland wf-recorder slurp curl)
install=canvas.install
optdepends=('hyprsunset: night light' 'udiskie: automount USB drives' 'pacman-contrib: update check' 'kdeconnect: connect your phone' 'fd: faster file search in the launcher')

package() {
  local src="${CANVAS_SRC:-$HOME/CanOS/canvas}"
  install -d "$pkgdir/usr/share/canvas" "$pkgdir/usr/bin"
  git -C "$src" -c tar.umask=0022 archive HEAD | tar -x -C "$pkgdir/usr/share/canvas"
  chmod 755 "$pkgdir/usr/share/canvas/bin/"* "$pkgdir/usr/share/canvas/greeter/install-greeter" "$pkgdir/usr/share/canvas/greeter/start-greeter" "$pkgdir/usr/share/canvas/greeter/start-session"
  ln -s /usr/share/canvas/bin/canvas "$pkgdir/usr/bin/canvas"
  install -Dm644 "$pkgdir"/usr/share/canvas/applications/*.desktop -t "$pkgdir/usr/share/applications/"
}
